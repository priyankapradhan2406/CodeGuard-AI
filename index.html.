
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CodeGuard AI | Code Intelligence</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:Inter,Arial,sans-serif;background:#0b1020;color:#e8edfa;min-height:100vh}
header{padding:20px 5%;border-bottom:1px solid #273149;display:flex;justify-content:space-between;align-items:center}
.logo{font-size:23px;font-weight:800;color:#a78bfa}
.logo span{color:#fff}
.status{font-size:12px;color:#86efac}
.container{max-width:1150px;margin:auto;padding:30px 5%}
h1{font-size:32px;margin-bottom:10px}
.subtitle{color:#929db5;margin-bottom:28px;line-height:1.6}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-bottom:25px}
.stat,.panel{background:#141d31;border:1px solid #293650;border-radius:13px;padding:20px}
.stat small{color:#929db5}
.stat h2{font-size:27px;margin-top:10px;color:#a78bfa}
.workspace{display:grid;grid-template-columns:1.5fr 1fr;gap:18px}
.panel h3{margin-bottom:18px}
select,textarea{width:100%;background:#0c1426;color:white;border:1px solid #35425e;border-radius:8px;padding:12px;font-size:14px;margin-bottom:14px}
textarea{height:290px;resize:vertical;font-family:monospace;line-height:1.6}
button{background:linear-gradient(100deg,#7c3aed,#4f46e5);border:0;color:white;padding:13px 18px;border-radius:8px;font-weight:700;cursor:pointer}
button:hover{opacity:.9}
.secondary{background:#28344d;margin-left:6px}
.score{font-size:48px;color:#a78bfa;font-weight:800;margin:10px 0}
.muted{color:#929db5;font-size:13px}
.issue{padding:12px;margin-top:12px;background:#202b40;border-radius:8px;border-left:3px solid #f59e0b;font-size:13px;line-height:1.6}
.good{border-left-color:#34d399}
.bad{border-left-color:#f87171}
.result-title{margin-top:22px}
footer{text-align:center;color:#78849c;padding:30px;font-size:12px}
@media(max-width:700px){
 .workspace{grid-template-columns:1fr}
 .stats{grid-template-columns:1fr 1fr}
 h1{font-size:26px}
 textarea{height:230px}
}
</style>
</head>
<body>
<header>
 <div class="logo">CodeGuard <span>AI</span></div>
 <div class="status">● System Online</div>
</header>

<main class="container">
 <h1>AI Code Intelligence</h1>
 <p class="subtitle">Analyze your code, identify potential problems and improve code quality.</p>

 <section class="stats">
  <div class="stat">
   <small>Reviews completed</small>
   <h2 id="reviews">0</h2>
  </div>
  <div class="stat">
   <small>Issues detected</small>
   <h2 id="issues">0</h2>
  </div>
  <div class="stat">
   <small>Current score</small>
   <h2 id="dashboardScore">--</h2>
  </div>
 </section>

 <section class="workspace">
  <div class="panel">
   <h3>⌨ Code Analyzer</h3>
   <select id="language">
    <option value="javascript">JavaScript</option>
    <option value="python">Python</option>
    <option value="java">Java</option>
    <option value="cpp">C++</option>
   </select>

   <textarea id="code" placeholder="Paste your code here...">function calculateTotal(a, b) {
  var password = "admin123";
  console.log("Calculating...");
  return a + b;
}</textarea>

   <button onclick="analyze()">Analyze Code →</button>
   <button class="secondary" onclick="clearCode()">Clear</button>
  </div>

  <div class="panel">
   <h3>📊 Analysis Report</h3>
   <p class="muted">Code quality score</p>
   <div class="score" id="score">--</div>
   <p class="muted" id="summary">Submit code to begin analysis.</p>

   <h3 class="result-title">Detected Issues</h3>
   <div id="results">
    <p class="muted">Your results will appear here.</p>
   </div>
  </div>
 </section>
</main>

<footer>CodeGuard AI · Developer Code Quality Assistant · Portfolio Project</footer>

<script>
let reviewCount=0;
let issueCount=0;

function analyze(){
 const code=document.getElementById("code").value;
 const lang=document.getElementById("language").value;
 const results=document.getElementById("results");
 const scoreBox=document.getElementById("score");

 if(!code.trim()){
  results.innerHTML='<div class="issue bad">Please enter some code first.</div>';
  return;
 }

 let findings=[];
 const add=(title,detail,type="warning")=>{
  findings.push({title,detail,type});
 };

 if(/password|api[_-]?key|secret/i.test(code)){
  add("Possible hardcoded secret","Check whether passwords, API keys or sensitive values are stored directly in source code.","bad");
 }

 if(/\beval\s*\(/.test(code)){
  add("Use of eval()","Dynamic code execution can introduce security risks. Consider safer alternatives.","bad");
 }

 if(/TODO|FIXME/.test(code)){
  add("Unfinished code marker","Review TODO or FIXME comments before considering the code complete.");
 }

 if(/console\.log|print\s*\(/.test(code)){
  add("Debug output found","Remove unnecessary debugging statements from production code.");
 }

 if(code.split("\n").length>100){
  add("Long code section","Consider splitting large sections into smaller functions or modules.");
 }

 if(lang==="javascript" && /\bvar\s+/.test(code)){
  add("Consider modern declarations","Use let or const where appropriate instead of var.");
 }

 if(lang==="python" && /except\s*:/.test(code)){
  add("Broad exception handling","Catch specific exceptions where possible.");
 }

 if(lang==="java" && /catch\s*\(\s*Exception/.test(code)){
  add("Broad exception handling","Consider catching specific exception types.");
 }

 if(/function\s+\w+|def\s+\w+|public\s+static/.test(code)===false){
  add("Check program structure","No common function or method declaration was detected. Check whether your code structure is appropriate.");
 }

 let score=Math.max(0,100-findings.reduce((total,item)=>{
  return total+(item.type==="bad"?20:10);
 },0));

 reviewCount++;
 issueCount+=findings.length;

 document.getElementById("reviews").textContent=reviewCount;
 document.getElementById("issues").textContent=issueCount;
 document.getElementById("dashboardScore").textContent=score;
 scoreBox.textContent=score+"/100";

 document.getElementById("summary").textContent=
 findings.length===0
 ? "No configured checks were triggered. This does not guarantee error-free code."
 : findings.length+" potential issue(s) identified by basic static checks.";

 results.innerHTML="";

 if(findings.length===0){
  results.innerHTML='<div class="issue good">✓ No issues detected by the configured checks. Further testing is still recommended.</div>';
 }else{
  findings.forEach(item=>{
   const div=document.createElement("div");
   div.className="issue "+(item.type==="bad"?"bad":"");
   const title=document.createElement("strong");
   title.textContent=item.title;
   const detail=document.createElement("p");
   detail.textContent=item.detail;
   div.appendChild(title);
   div.appendChild(detail);
   results.appendChild(div);
  });
 }
}

function clearCode(){
 document.getElementById("code").value="";
 document.getElementById("results").innerHTML=
 '<p class="muted">Your results will appear here.</p>';
 document.getElementById("score").textContent="--";
 document.getElementById("summary").textContent="Submit code to begin analysis.";
}
</script>
</body>
</html>
